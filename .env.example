# SupportSwarm Environment Configuration Example
PROJECT_NAME="SupportSwarm"
VERSION="1.0.0"
SECRET_KEY="supportswarm-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector in production, SQLite in development)
DATABASE_URL="sqlite+aiosqlite:///./supportswarm.db"
SYNC_DATABASE_URL="sqlite:///./supportswarm.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/supportswarm"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportswarm"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Local Storage
STORAGE_DIR="./storage"

# AI Adapters & Orchestration
AI_MODEL_PROVIDER="mock_hermes"
HERMES_API_URL="http://localhost:8001"
PAPERCLIP_API_URL="http://localhost:8002"
OPENAI_API_KEY=""

# Guardrails & Thresholds
CONFIDENCE_THRESHOLD_MIN=0.70
INCIDENT_WINDOW_MINUTES=30
INCIDENT_MIN_TICKETS=5

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
